{
  "manifest_version": 3,
  "name": "Jarvis Chrome Control",
  "version": "0.2.0",
  "description": "Lets a locally paired Jarvis read and control only the websites you approve.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:3100/*",
    "http://localhost:3000/*",
    "http://localhost:3100/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jarvis Chrome Control",
    "default_popup": "popup.html"
  }
}
