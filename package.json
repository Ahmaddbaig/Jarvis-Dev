{
  "name": "jarvis-client",
  "version": "1.1.0",
  "description": "Jarvis V5 - AI Desktop Assistant",
  "main": "dist-electron/main.js",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "packages/*",
    "apps/companion"
  ],
  "allowScripts": {
    "electron@43.3.0": true,
    "@jitsi/robotjs@0.6.24": true,
    "sharp@0.35.3": true
  },
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE=1 ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron ./node_modules/next/dist/bin/next dev --webpack -H 127.0.0.1 -p 3100",
    "predev:desktop": "npm run build:electron",
    "dev:desktop": "JARVIS_CHROME_UI_TOKEN=$(/usr/bin/openssl rand -hex 32) concurrently -k -n \"NEXT,ELECTRON\" -c \"cyan,green\" \"ELECTRON_RUN_AS_NODE=1 ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron ./node_modules/next/dist/bin/next dev --webpack -H 127.0.0.1 -p 3100\" \"wait-on http://127.0.0.1:3100 && JARVIS_PORT=3100 JARVIS_HTTPS_PORT=3543 electron .\"",
    "serve": "next build && next start -H 127.0.0.1 -p 3000",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "sync:mediapipe": "node electron-scripts/sync-mediapipe.js",
    "el:list": "node scripts/elevenlabs-sync.mjs --list",
    "el:sync": "node scripts/elevenlabs-sync.mjs",
    "el:sync:dry": "node scripts/elevenlabs-sync.mjs --dry-run",
    "el:tune": "node scripts/elevenlabs-tune-agent.mjs",
    "ai:setup": "node electron-scripts/ai-engine.js setup",
    "ai:test": "node electron-scripts/ai-engine.js test",
    "ai:lint": "node electron-scripts/ai-engine.js lint",
    "ai:dev": "node electron-scripts/ai-engine.js dev",
    "build:ai": "node electron-scripts/ai-engine.js build",
    "build:python": "node electron-scripts/build-python.js && npm run build:ai",
    "ai:smoke": "node scripts/release/ai-frozen-smoke.mjs",
    "build": "npm run sync:mediapipe && npm run build:python && npm run build:next && node electron-scripts/postbuild.js && npm run build:electron && npm run build:companion && npm run release:evidence",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "dist": "npm run build && electron-builder --mac --win --publish never",
    "companion": "npm run start --workspace jarvis-companion",
    "companion:server": "npm run server --workspace jarvis-companion",
    "companion:dist": "npm run dist --workspace jarvis-companion",
    "build:companion": "npm run build --workspace jarvis-companion",
    "refactor:baseline": "node scripts/refactor/check-baseline.mjs",
    "refactor:routes": "node scripts/refactor/validate-route-inventory.mjs",
    "refactor:voice-benchmark": "node scripts/refactor/voice-benchmark.mjs",
    "refactor:resources": "node scripts/refactor/validate-packaged-resources.mjs",
    "refactor:rollback": "vitest run tests/releaseRollback.test.ts",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "release:manifest": "node scripts/release/generate-artifact-manifest.mjs",
    "release:evidence": "npm run release:sbom && npm run release:manifest -- --require-built && npm run refactor:resources -- --require-built",
    "release:supply-chain": "node scripts/release/verify-supply-chain.mjs",
    "release:policy": "node scripts/release/validate-release-policy.mjs",
    "release:signing": "node scripts/release/verify-signing.mjs",
    "release:smoke": "node scripts/release/standalone-smoke.mjs",
    "release:desktop-smoke": "node scripts/release/desktop-package-smoke.mjs",
    "prestart": "npm run build:electron",
    "start": "electron .",
    "lint": "node scripts/refactor/check-lint-budget.mjs",
    "lint:report": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check": "npm run lint && npm test && npm run ai:lint && npm run ai:test && npm run typecheck && npm run refactor:routes -- --check && npm run refactor:resources && npm run release:policy",
    "test": "vitest run",
    "postinstall": "node node_modules/electron/install.js && node scripts/copy-vad-assets.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@elevenlabs/react": "^1.4.0",
    "@jitsi/robotjs": "^0.6.22",
    "@ricky0123/vad-web": "^0.0.30",
    "@tanstack/react-query": "^5.101.4",
    "@types/leaflet": "^1.9.21",
    "http-proxy": "^1.18.1",
    "leaflet": "^1.9.4",
    "mqtt": "^5.15.1",
    "selfsigned": "^5.5.0",
    "sharp": "0.35.3",
    "smart-buffer": "^4.2.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.17",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "framer-motion": "^12.33.0",
    "next": "16.3.0",
    "openai": "^6.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "screenshot-desktop": "^1.15.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  }
}
