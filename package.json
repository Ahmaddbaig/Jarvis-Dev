{
  "name": "jarvis-client",
  "version": "1.1.0",
  "description": "Jarvis V5 - AI Desktop Assistant",
  "main": "dist-electron/main.js",
  "private": true,
  "allowScripts": {
    "electron@36.9.5": true
  },
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE=1 ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron ./node_modules/next/dist/bin/next dev --webpack -H 127.0.0.1 -p 3100",
    "dev:desktop": "concurrently -k -n \"NEXT,ELECTRON\" -c \"cyan,green\" \"ELECTRON_RUN_AS_NODE=1 ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron ./node_modules/next/dist/bin/next dev --webpack -H 127.0.0.1 -p 3100\" \"wait-on http://127.0.0.1:3100 && JARVIS_PORT=3100 JARVIS_HTTPS_PORT=3543 electron .\"",
    "serve": "next build && next start -H 0.0.0.0 -p 3000",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:python": "node electron-scripts/build-python.js",
    "build": "npm run build:python && npm run build:next && node electron-scripts/postbuild.js && npm run build:electron",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist": "npm run build && electron-builder --mac --win --publish never",
    "companion": "npm --prefix scripts/companion start",
    "companion:server": "node scripts/companion/server.cjs",
    "start": "electron .",
    "lint": "eslint"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.4.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "mqtt": "^5.15.1",
    "smart-buffer": "^4.2.0"
  },
  "devDependencies": {
    "@jitsi/robotjs": "^0.6.22",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "framer-motion": "^12.33.0",
    "http-proxy": "^1.18.1",
    "next": "16.1.6",
    "openai": "^6.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "screenshot-desktop": "^1.15.4",
    "selfsigned": "^5.5.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "typescript": "^5",
    "wait-on": "^8.0.0"
  }
}
