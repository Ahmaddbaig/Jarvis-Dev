{
  "schemaVersion": 1,
  "supportedMatrix": [
    { "platform": "macos", "architecture": "arm64", "minimumVersion": "12.0", "support": "stable" },
    { "platform": "windows", "architecture": "x64", "minimumVersion": "10", "support": "stable" },
    { "platform": "linux", "architecture": "x64", "minimumVersion": null, "support": "experimental" }
  ],
  "distribution": {
    "signatureRequired": true,
    "macNotarizationRequired": true,
    "sbomRequired": true,
