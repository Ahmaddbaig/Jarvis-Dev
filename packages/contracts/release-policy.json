    "lastKnownGoodRequired": true,
    "stagedRolloutRequired": true,
    "preserveModelDirectories": true
  },
  "compatibility": {
    "legacyMigrationReaders": "retain-through-one-stable-release",
    "remoteProtocol": 2,
    "aiEngineProtocol": "jarvis.ai-engine/1",
    "databaseSchema": 2
  }
}
